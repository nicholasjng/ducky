+namespace {
+
+//! Backs the stream from duckdb_result_arrow_array_stream: the record batches the engine built during execution,
+//! and a copy of the schema the format resolved at submission, so the stream depends on neither the connection nor
+//! the result
+struct ArrowResultStream {
+	~ArrowResultStream() {
+		if (schema.release) {
+			schema.release(&schema);
+		}
+	}
+	duckdb::unique_ptr<duckdb::ArrowArrayCollection> arrays;
+	idx_t index = 0;
+	ArrowSchema schema {};
+	std::string last_error;
+};
+
+int ArrowResultStreamGetSchema(struct ArrowArrayStream *stream, struct ArrowSchema *out) {
+	auto &state = *reinterpret_cast<ArrowResultStream *>(stream->private_data);
+	if (duckdb_nanoarrow::ArrowSchemaDeepCopy(&state.schema, out) != NANOARROW_OK) {
+		state.last_error = "failed to copy the Arrow schema";
+		return ENOMEM;
+	}
+	return 0;
+}
+
+int ArrowResultStreamGetNext(struct ArrowArrayStream *stream, struct ArrowArray *out) {
+	auto &state = *reinterpret_cast<ArrowResultStream *>(stream->private_data);
+	// End-of-stream is signalled with a released array
+	out->release = nullptr;
+	if (state.index >= state.arrays->size()) {
+		return 0;
+	}
+	try {
+		// The export holds the array's owner, so the stream can drop its own reference
+		auto &owner = (*state.arrays)[state.index];
+		auto exported = ArrowFormat::ShareArray(owner);
+		owner.reset();
+		state.index++;
+		exported->MoveTo(*out);
+	} catch (std::exception &ex) {
+		state.last_error = duckdb::ErrorData(ex).Message();
+		return EIO;
+	}
+	return 0;
+}
+
+const char *ArrowResultStreamGetLastError(struct ArrowArrayStream *stream) {
+	auto &state = *reinterpret_cast<ArrowResultStream *>(stream->private_data);
+	return state.last_error.empty() ? nullptr : state.last_error.c_str();
+}
+
+void ArrowResultStreamRelease(struct ArrowArrayStream *stream) {
+	if (!stream->release) {
+		return;
+	}
+	delete reinterpret_cast<ArrowResultStream *>(stream->private_data);
+	stream->private_data = nullptr;
+	stream->release = nullptr;
+}
+
+} // namespace
+
+duckdb_error_data duckdb_result_arrow_array_stream(duckdb_result *result, struct ArrowArrayStream *out_stream) {
+	if (!result || !result->internal_data || !out_stream) {
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT,
+		                                "Invalid argument(s) to duckdb_result_arrow_array_stream");
+	}
+	auto &result_data = *reinterpret_cast<duckdb::DuckDBResultData *>(result->internal_data);
+	if (result_data.HasError()) {
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT, result_data.GetError().c_str());
+	}
+	if (result_data.IsStreaming() || !result_data.Retained().Format().Is<ArrowFormat>()) {
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT,
+		                                "duckdb_result_arrow_array_stream requires a result produced with "
+		                                "duckdb_pending_prepared_arrow");
+	}
+	auto &query_result = result_data.Retained();
+	try {
+		auto state = duckdb::make_uniq<ArrowResultStream>();
+		if (duckdb_nanoarrow::ArrowSchemaDeepCopy(&query_result.FormatState<ArrowFormat>().Schema(), &state->schema) !=
+		    NANOARROW_OK) {
+			throw duckdb::OutOfMemoryException("failed to copy the Arrow schema");
+		}
+		state->arrays = query_result.TakeCollection<ArrowFormat>();
+
+		out_stream->get_schema = ArrowResultStreamGetSchema;
+		out_stream->get_next = ArrowResultStreamGetNext;
+		out_stream->get_last_error = ArrowResultStreamGetLastError;
+		out_stream->release = ArrowResultStreamRelease;
+		out_stream->private_data = state.release();
+	} catch (std::exception &ex) {
+		duckdb::ErrorData error(ex);
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT, error.Message().c_str());
+	}
+	return nullptr;
+}

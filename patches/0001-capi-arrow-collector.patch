+namespace {
+
+//! Backing state for the stream produced by duckdb_result_arrow_array_stream:
+//! the record batches the Arrow collector already built during execution, plus
+//! what is needed to produce the schema on demand (get_schema may be called
+//! before any batch is pulled, and the arrays carry no schema of their own).
+struct DuckDBArrowStreamState {
+	duckdb::vector<duckdb::unique_ptr<duckdb::ArrowArrayWrapper>> arrays;
+	idx_t index = 0;
+	duckdb::vector<LogicalType> types;
+	duckdb::vector<std::string> names;
+	duckdb::ClientProperties client_properties;
+	std::string last_error;
+};
+
+int DuckDBArrowStreamGetSchema(struct ArrowArrayStream *stream, struct ArrowSchema *out) {
+	auto state = reinterpret_cast<DuckDBArrowStreamState *>(stream->private_data);
+	try {
+		ArrowConverter::ToArrowSchema(out, state->types, state->names, state->client_properties);
+	} catch (std::exception &ex) {
+		state->last_error = ex.what();
+		return EIO;
+	}
+	return 0;
+}
+
+int DuckDBArrowStreamGetNext(struct ArrowArrayStream *stream, struct ArrowArray *out) {
+	auto state = reinterpret_cast<DuckDBArrowStreamState *>(stream->private_data);
+	// End-of-stream is signalled with a released array.
+	out->release = nullptr;
+	if (state->index >= state->arrays.size()) {
+		return 0;
+	}
+	// Hand ownership of the next array to the consumer: move the struct and
+	// null the source's release pointer so the wrapper's destructor is a no-op.
+	auto &src = state->arrays[state->index++]->arrow_array;
+	*out = src;
+	src.release = nullptr;
+	return 0;
+}
+
+const char *DuckDBArrowStreamGetLastError(struct ArrowArrayStream *stream) {
+	auto state = reinterpret_cast<DuckDBArrowStreamState *>(stream->private_data);
+	return state->last_error.empty() ? nullptr : state->last_error.c_str();
+}
+
+void DuckDBArrowStreamRelease(struct ArrowArrayStream *stream) {
+	if (!stream->release) {
+		return;
+	}
+	auto state = reinterpret_cast<DuckDBArrowStreamState *>(stream->private_data);
+	// Frees any unconsumed arrays via the wrappers' destructors.
+	delete state;
+	stream->private_data = nullptr;
+	stream->release = nullptr;
+}
+
+} // namespace
+
+duckdb_error_data duckdb_result_arrow_array_stream(duckdb_result *result, struct ArrowArrayStream *out_stream) {
+	if (!result || !out_stream) {
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT,
+		                                "Invalid argument(s) to duckdb_result_arrow_array_stream");
+	}
+	auto result_data = reinterpret_cast<duckdb::DuckDBResultData *>(result->internal_data);
+	auto query_result = result_data ? result_data->result.get() : nullptr;
+	if (!query_result || query_result->GetResultType() != QueryResultType::ARROW_RESULT) {
+		return duckdb_create_error_data(DUCKDB_ERROR_INVALID_INPUT,
+		                                "duckdb_result_arrow_array_stream requires a result produced with "
+		                                "duckdb_pending_prepared_arrow");
+	}
+	auto &arrow_result = reinterpret_cast<duckdb::ArrowQueryResult &>(*query_result);
+
+	auto state = new DuckDBArrowStreamState();
+	state->arrays = arrow_result.ConsumeArrays();
+	state->types = arrow_result.GetTypes();
+	state->names = duckdb::IdentifiersToStrings(arrow_result.GetNames());
+	state->client_properties = arrow_result.client_properties;
+
+	out_stream->get_schema = DuckDBArrowStreamGetSchema;
+	out_stream->get_next = DuckDBArrowStreamGetNext;
+	out_stream->get_last_error = DuckDBArrowStreamGetLastError;
+	out_stream->release = DuckDBArrowStreamRelease;
+	out_stream->private_data = state;
+	return nullptr;
+}

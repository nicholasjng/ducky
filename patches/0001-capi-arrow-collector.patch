+duckdb_state duckdb_pending_prepared_arrow(duckdb_prepared_statement prepared_statement, idx_t rows_per_batch,
+                                           duckdb_pending_result *out_result) {
+	if (!prepared_statement || !out_result) {
+		return DuckDBError;
+	}
+	auto wrapper = reinterpret_cast<PreparedStatementWrapper *>(prepared_statement);
+	if (!wrapper->statement || !wrapper->statement->context) {
+		return DuckDBError;
+	}
+	auto result = new PendingStatementWrapper();
+	result->allow_streaming = false;
+
+	// Install the Arrow result collector so execution assembles Arrow record
+	// batches directly (no chunk materialization + conversion pass). The hook
+	// is consumed at plan time inside PendingQuery, so the previous collector
+	// is restored right after.
+	auto &config = duckdb::ClientConfig::GetConfig(*wrapper->statement->context);
+	auto previous_collector = config.get_result_collector;
+	// 0 selects the default batch size (matches the Python client's default).
+	const idx_t batch_size = rows_per_batch == 0 ? 1000000 : rows_per_batch;
+	config.get_result_collector = [batch_size](duckdb::ClientContext &context, duckdb::PreparedStatementData &data) {
+		return duckdb::PhysicalArrowCollector::Create(context, data, batch_size);
+	};
+	try {
+		result->statement = wrapper->statement->PendingQuery(wrapper->values, false);
+	} catch (std::exception &ex) {
+		result->statement = make_uniq<PendingQueryResult>(duckdb::ErrorData(ex));
+	}
+	config.get_result_collector = std::move(previous_collector);
+
+	duckdb_state return_value = !result->statement->HasError() ? DuckDBSuccess : DuckDBError;
+	*out_result = reinterpret_cast<duckdb_pending_result>(result);
+
+	return return_value;
+}

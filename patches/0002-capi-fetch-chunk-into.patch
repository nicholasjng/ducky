 }
+
+bool duckdb_fetch_chunk_into(duckdb_result result, duckdb_data_chunk chunk) {
+	if (!result.internal_data || !chunk) {
+		return false;
+	}
+	auto &result_data = *((duckdb::DuckDBResultData *)result.internal_data);
+	if (result_data.result_set_type == duckdb::CAPIResultSetType::CAPI_RESULT_TYPE_DEPRECATED) {
+		return false;
+	}
+	result_data.result_set_type = duckdb::CAPIResultSetType::CAPI_RESULT_TYPE_STREAMING;
+	auto &result_instance = (duckdb::QueryResult &)*result_data.result;
+	auto &dchunk = *(reinterpret_cast<duckdb::DataChunk *>(chunk));
+	try {
+		if (dchunk.ColumnCount() != result_instance.GetTypes().size()) {
+			throw duckdb::InvalidInputException(
+			    "duckdb_fetch_chunk_into: the chunk's column count does not match the result's");
+		}
+		if (result_instance.GetResultType() == duckdb::QueryResultType::MATERIALIZED_RESULT) {
+			// Scan the collection directly into the caller's chunk: no per-fetch
+			// DataChunk allocation, unlike duckdb_fetch_chunk.
+			auto &materialized = (duckdb::MaterializedQueryResult &)result_instance;
+			return materialized.FetchInto(dchunk);
+		}
+		// Other result types have no scan-into path: fetch a chunk and reference
+		// its buffers (shared ownership; correct, but no allocation win).
+		auto fetched = result_instance.Fetch();
+		if (!fetched || fetched->size() == 0) {
+			return false;
+		}
+		dchunk.Reference(*fetched);
+		return true;
+	} catch (std::exception &e) {
+		// Set the error on the result so duckdb_result_error can retrieve it
+		duckdb::ErrorData error(e);
+		result_instance.SetError(error);
+		return false;
+	}
+}
diff --git a/src/main/materialized_query_result.cpp b/src/main/materialized_query_result.cpp
index 110c605..8e3d61f 100644
--- a/src/main/materialized_query_result.cpp
+++ b/src/main/materialized_query_result.cpp
@@ -104,4 +104,17 @@ unique_ptr<DataChunk> MaterializedQueryResult::FetchInternal() {
 	return result;
 }

+bool MaterializedQueryResult::FetchInto(DataChunk &result) {
+	if (HasError()) {
+		throw InvalidInputException("Attempting to fetch from an unsuccessful query result\nError: %s", GetError());
+	}
+	if (!scan_initialized) {
+		// we disallow zero copy so the chunk is independently usable even after the result is destroyed
+		collection->InitializeScan(scan_state, ColumnDataScanProperties::DISALLOW_ZERO_COPY);
+		scan_initialized = true;
+	}
+	collection->Scan(scan_state, result);
+	return result.size() != 0;
+}
+
 } // namespace duckdb

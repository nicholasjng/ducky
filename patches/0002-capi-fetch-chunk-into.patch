+
+bool duckdb_fetch_chunk_into(duckdb_result result, duckdb_data_chunk chunk) {
+	if (!result.internal_data || !chunk) {
+		return false;
+	}
+	auto &result_data = *((duckdb::DuckDBResultData *)result.internal_data);
+	if (result_data.result_set_type == duckdb::CAPIResultSetType::CAPI_RESULT_TYPE_DEPRECATED) {
+		return false;
+	}
+	if (result_data.IsOtherFormat()) {
+		// Refuse without touching the result's state, so it can still be exported in its own format
+		return false;
+	}
+	result_data.result_set_type = duckdb::CAPIResultSetType::CAPI_RESULT_TYPE_STREAMING;
+	auto &dchunk = *(reinterpret_cast<duckdb::DataChunk *>(chunk));
+	try {
+		auto &types = result_data.GetTypes();
+		if (dchunk.ColumnCount() != types.size()) {
+			throw duckdb::InvalidInputException(
+			    "duckdb_fetch_chunk_into: the chunk's column count does not match the result's");
+		}
+		for (idx_t i = 0; i < types.size(); i++) {
+			// The scan writes with the destination's physical layout, so a mismatch would reinterpret the data
+			if (dchunk.data[i].GetType() != types[i]) {
+				throw duckdb::InvalidInputException(
+				    "duckdb_fetch_chunk_into: column %llu of the chunk has type %s, but the result's has type %s", i,
+				    dchunk.data[i].GetType().ToString(), types[i].ToString());
+			}
+		}
+		if (!result_data.IsStreaming()) {
+			// Scan the retained collection directly into the caller's chunk: no per-fetch DataChunk allocation,
+			// unlike duckdb_fetch_chunk
+			return result_data.Retained().FetchInto(dchunk);
+		}
+		// A stream hands out chunks it already owns: reference their buffers (shared ownership; correct, but no
+		// allocation win)
+		auto fetched = result_data.stream->Fetch();
+		if (!fetched || fetched->size() == 0) {
+			return false;
+		}
+		dchunk.Reference(*fetched);
+		return true;
+	} catch (std::exception &e) {
+		// Set the error on the result so duckdb_result_error can retrieve it
+		duckdb::ErrorData error(e);
+		if (result_data.stream) {
+			result_data.stream->SetError(std::move(error));
+		} else {
+			result_data.result->SetError(std::move(error));
+		}
+		return false;
+	}
+}
diff --git a/src/main/query_result.cpp b/src/main/query_result.cpp
index 46f5a5ff9ce..261ca8910b8 100644
--- a/src/main/query_result.cpp
+++ b/src/main/query_result.cpp
@@ -440,6 +440,24 @@ unique_ptr<DataChunk> QueryResult::FetchRaw() {
 	return collection->Cast<ChunkRetainedCollection>().FetchRaw();
 }
 
+bool QueryResult::FetchInto(DataChunk &result) {
+	Complete();
+	if (HasError()) {
+		throw InvalidInputException("Attempting to fetch from an unsuccessful query result\nError: %s", GetError());
+	}
+	if (!Format().Is<ChunkFormat>()) {
+		ThrowFormatMismatch(ChunkFormat::NAME);
+	}
+	if (!collection) {
+		ThrowNoCollection();
+	}
+	if (!collection->Cast<ChunkRetainedCollection>().FetchInto(result)) {
+		return false;
+	}
+	result.Flatten();
+	return true;
+}
+

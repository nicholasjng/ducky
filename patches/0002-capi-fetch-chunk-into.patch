diff --git a/src/main/retained_result_collection.cpp b/src/main/retained_result_collection.cpp
index f3c2b8b9009..7841eabe0ee 100644
--- a/src/main/retained_result_collection.cpp
+++ b/src/main/retained_result_collection.cpp
@@ -102,17 +102,28 @@ unique_ptr<DataChunk> ChunkRetainedCollection::FetchRaw() {
 	}
 	auto result = make_uniq<DataChunk>();
 	collection->InitializeScanChunk(*result);
+	if (!FetchInto(*result)) {
+		return nullptr;
+	}
+	return result;
+}
+
+bool ChunkRetainedCollection::FetchInto(DataChunk &result) {
+	D_ASSERT(collection);
+	if (scan_exhausted) {
+		return false;
+	}
 	if (!scan_initialized) {
 		// Disallow zero copy so the chunk is independently usable even after the collection is destroyed
 		collection->InitializeScan(scan_state, ColumnDataScanProperties::DISALLOW_ZERO_COPY);
 		scan_initialized = true;
 	}
-	collection->Scan(scan_state, *result);
-	if (result->size() == 0) {
+	collection->Scan(scan_state, result);
+	if (result.size() == 0) {
 		scan_exhausted = true;
-		return nullptr;
+		return false;
 	}
-	return result;
+	return true;
 }
 
 } // namespace duckdb

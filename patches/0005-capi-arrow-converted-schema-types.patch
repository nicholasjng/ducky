 }
 
+idx_t duckdb_arrow_converted_schema_column_count(duckdb_arrow_converted_schema converted_schema) {
+	if (!converted_schema) {
+		return 0;
+	}
+	return reinterpret_cast<duckdb::ArrowTableSchema *>(converted_schema)->GetTypes().size();
+}
+
+duckdb_logical_type duckdb_arrow_converted_schema_column_type(duckdb_arrow_converted_schema converted_schema,
+                                                              idx_t index) {
+	if (!converted_schema) {
+		return nullptr;
+	}
+	auto &types = reinterpret_cast<duckdb::ArrowTableSchema *>(converted_schema)->GetTypes();
+	if (index >= types.size()) {
+		return nullptr;
+	}
+	return reinterpret_cast<duckdb_logical_type>(new LogicalType(types[index]));
+}
+

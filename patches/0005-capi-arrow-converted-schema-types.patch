@@ -2852,6 +2852,26 @@ DUCKDB_C_API duckdb_error_data duckdb_data_chunk_from_arrow(duckdb_connection co
  */
 DUCKDB_C_API void duckdb_destroy_arrow_converted_schema(duckdb_arrow_converted_schema *arrow_converted_schema);
 
+/*!
+Returns the number of columns of an Arrow schema converted with `duckdb_schema_from_arrow`.
+
+* @param converted_schema The converted schema.
+* @return The number of columns, or 0 if `converted_schema` is NULL.
+*/
+DUCKDB_C_API idx_t duckdb_arrow_converted_schema_column_count(duckdb_arrow_converted_schema converted_schema);
+
+/*!
+Returns the DuckDB logical type that column `index` of a converted Arrow schema is read as. This is the type
+`duckdb_data_chunk_from_arrow` produces for that column, available without converting any data (e.g. for a source
+that has no batches). The result must be destroyed with `duckdb_destroy_logical_type`.
+
+* @param converted_schema The converted schema.
+* @param index The column index.
+* @return The logical type, or NULL if `converted_schema` is NULL or `index` is out of range.
+*/
+DUCKDB_C_API duckdb_logical_type duckdb_arrow_converted_schema_column_type(duckdb_arrow_converted_schema converted_schema,
+                                                                          idx_t index);
+
 /*!
 Exposes an executed result in the Arrow format (from `duckdb_pending_prepared_arrow`) as an Arrow C stream interface
 `ArrowArrayStream`. Ownership of the record batches moves into the stream, which also holds its own copy of the schema:

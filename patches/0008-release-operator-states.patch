@@ -15,6 +18,23 @@
 
 namespace duckdb {
 
+void PhysicalPlan::ReleaseOperatorStates() {
+	for (auto &op : ops) {
+		auto &op_ref = op.get();
+		{
+			lock_guard<mutex> guard(op_ref.lock);
+			op_ref.sink_state.reset();
+			op_ref.op_state.reset();
+		}
+		if (op_ref.type == PhysicalOperatorType::EXECUTE) {
+			auto &execute = op_ref.Cast<PhysicalExecute>();
+			if (execute.prepared && execute.prepared->physical_plan) {
+				execute.prepared->physical_plan->ReleaseOperatorStates();
+			}
+		}
+	}
+}
+
 PhysicalPlanGenerator::PhysicalPlanGenerator(ClientContext &context) : context(context) {
 }
 

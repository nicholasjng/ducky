+DUCKDB_V2_ERROR duckdb_v2_instance_open_v1(duckdb_v2_instance_handle instance, duckdb_database *out_database,
+                                           duckdb_v2_error_info_handle *err) {
+	DUCKDB_CHECK_ARG(instance);
+	DUCKDB_CHECK_ARG(out_database);
+	*out_database = nullptr;
+	return WithErrorHandler(err, [&]() {
+		auto wrapper = duckdb::make_uniq<duckdb::DatabaseWrapper>();
+		wrapper->database = duckdb::make_shared_ptr<duckdb::DuckDB>(*Convert(instance)->GetDatabase().instance);
+		*out_database = reinterpret_cast<duckdb_database>(wrapper.release());
+	});
+}

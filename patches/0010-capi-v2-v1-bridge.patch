Bridge C API v2 connections to C API v1 handles

C API v2 has no appender, and v1 and v2 handles do not convert into each other,
so a client that moves its connections to v2 loses the v1 functions v2 has no
counterpart for. Both wrap the same engine object: a v2 connection is a
Connection, which is what a v1 connection handle points to. Add, in
duckdb_v2_bridge.h, duckdb_v2_connection_get_v1(conn): the borrowed v1 handle
of a v2 connection, valid until the v2 connection is destroyed. A query run
through the v1 handle does not count as the v2 connection's running statement.

Note for upstreaming: duckdb_v2.h is generated; an upstream PR would add these
to its generator's definitions, or keep them in a hand-written header like this
one.
diff --git a/src/include/duckdb_v2_bridge.h b/src/include/duckdb_v2_bridge.h
new file mode 100644
index 00000000..43490e6a
--- /dev/null
+++ b/src/include/duckdb_v2_bridge.h
@@ -0,0 +1,39 @@
+//===----------------------------------------------------------------------===//
+//
+//                         DuckDB
+//
+// duckdb_v2_bridge.h
+//
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb.h"
+#include "duckdb_v2.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if DUCKDB_V2_API_ALLOW_UNSTABLE
+/*!
+ * Returns the C API v1 handle of a v2 connection, for v1 functions that v2 has no counterpart for, such as the
+ * appender.
+ *
+ * The handle is borrowed: it is valid until `duckdb_v2_connection_destroy()`, and must not be passed to
+ * `duckdb_disconnect()`. A query run through it does not count as the v2 connection's running statement, so do not
+ * run one while a v2 result on the connection is live.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param conn The v2 connection.
+ * @return The v1 connection handle, or NULL when `conn` is NULL.
+ */
+DUCKDB_C_API duckdb_connection duckdb_v2_connection_get_v1(duckdb_v2_connection_handle conn);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/main/capi/v2/capi_v2_connection.cpp b/src/main/capi/v2/capi_v2_connection.cpp
index 2d88d63c..d735a385 100644
--- a/src/main/capi/v2/capi_v2_connection.cpp
+++ b/src/main/capi/v2/capi_v2_connection.cpp
@@ -1,4 +1,5 @@
 #include "duckdb/main/capi_v2/capi_v2_internal.hpp"
+#include "duckdb_v2_bridge.h"
 
 using namespace duckdb::capiv2;
 
@@ -26,6 +27,12 @@ DUCKDB_V2_ERROR duckdb_v2_connection_destroy(duckdb_v2_connection_handle *conn)
 	});
 }
 
+duckdb_connection duckdb_v2_connection_get_v1(duckdb_v2_connection_handle conn) {
+	// A v1 connection handle is the Connection itself
+	duckdb::Connection *connection = conn ? Convert(conn) : nullptr;
+	return reinterpret_cast<duckdb_connection>(connection);
+}
+

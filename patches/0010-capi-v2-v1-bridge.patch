+duckdb_connection duckdb_v2_connection_get_v1(duckdb_v2_connection_handle conn) {
+	// A v1 connection handle is the Connection itself
+	duckdb::Connection *connection = conn ? Convert(conn) : nullptr;
+	return reinterpret_cast<duckdb_connection>(connection);
+}

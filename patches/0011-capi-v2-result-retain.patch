+//===----------------------------------------------------------------------===//
+//
+//                         DuckDB
+//
+// duckdb_v2_result_retain.h
+//
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb_v2.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if DUCKDB_V2_API_ALLOW_UNSTABLE
+/*!
+ * Retains a result instead of streaming it.
+ *
+ * A result that streams holds at most `max_streaming_buffer_size` of rows that the consumer has not taken, and parks
+ * the query's workers until the consumer steps; a statement that keeps the source order of its rows then runs mostly
+ * on the consumer's thread. A retained result runs to its end without waiting on the consumer, in parallel, keeping
+ * every row; stepping it yields the same chunks. Retain a result that will be read to its end anyway.
+ *
+ * Call it before the first step. A no-op for a result that is retained already, such as one of a statement that does
+ * not return rows, and for a result that has ended. Fails with `ERROR_INPUT_INVALID` once the result has started
+ * streaming.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param result The result.
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_result_retain(duckdb_v2_result_handle result, duckdb_v2_error_info_handle *err);
+
+/*!
+ * Retains an Arrow result instead of streaming it; see `duckdb_v2_result_retain()`.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param result The Arrow result.
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_arrow_result_retain(duckdb_v2_arrow_result_handle result,
+                                                         duckdb_v2_error_info_handle *err);
+#endif
+
+#ifdef __cplusplus
+}
+#endif

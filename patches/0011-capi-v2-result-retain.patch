 }
 
+DUCKDB_V2_ERROR duckdb_v2_result_retain(duckdb_v2_result_handle result, duckdb_v2_error_info_handle *err) {
+	DUCKDB_CHECK_ARG(result);
+	return WithErrorHandler(err, [&]() { Convert(result)->Retain(); });

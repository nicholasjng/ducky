+void ResultWrapperV2::Retain() {
+	if (state == State::STREAMING && stream) {
+		throw InvalidInputException("the result is already streaming; retain it before stepping it");
+	}
+	if (state != State::PENDING || !stream_when_ready) {
+		return;
+	}
+	handle->Materialize();
+	stream_when_ready = false;
+}

+/*!
+ * Returns the result schema the statement was prepared with: the names and types of its result columns, as
+ * `duckdb_v2_statement_bind()` reports them, without binding the statement again. A statement with a parameter whose
+ * type was not resolved reports a single `unknown` column of type UNKNOWN.
+ *
+ * Fails with `ERROR_INPUT_METADATA_DEFERRED` for a statement that expands into several, whose schema is known only once
+ * execution binds the one that produces the result.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param prepared The prepared statement.
+ * @param out_schema On success, receives the schema. Destroy via `duckdb_v2_schema_destroy()`.
+ * @param err Optional. On failure, receives an opaque info handle the caller must destroy via
+ * `duckdb_v2_error_info_destroy()`.
+ * @return DUCKDB_V2_ERROR
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_prepared_statement_get_schema(duckdb_v2_prepared_statement_handle prepared,
+                                                                     duckdb_v2_schema_handle *out_schema,
+                                                                     duckdb_v2_error_info_handle *err);
+
+/*!
+ * Returns the parameters of the statement in binding order, as `duckdb_v2_statement_bind()` reports them, without
+ * binding the statement again. Each field's name is the parameter's binding key, "1", "2", ... for a positional
+ * parameter, and its type is the one the plan assumed, or UNKNOWN when it was not resolved. Executing with values of
+ * those types reuses the plan.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param prepared The prepared statement.
+ * @param out_parameters On success, receives the parameters as a schema. Destroy via `duckdb_v2_schema_destroy()`.
+ * @param err Optional. On failure, receives an opaque info handle the caller must destroy via
+ * `duckdb_v2_error_info_destroy()`.
+ * @return DUCKDB_V2_ERROR
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_prepared_statement_get_parameters(duckdb_v2_prepared_statement_handle prepared,
+                                                                         duckdb_v2_schema_handle *out_parameters,
+                                                                         duckdb_v2_error_info_handle *err);
+#endif
+
+#ifdef __cplusplus
+}
+#endif

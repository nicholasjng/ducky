+DUCKDB_V2_ERROR duckdb_v2_prepared_statement_get_schema(duckdb_v2_prepared_statement_handle prepared,
+                                                        duckdb_v2_schema_handle *out_schema,
+                                                        duckdb_v2_error_info_handle *err) {
+	DUCKDB_CHECK_ARG(out_schema);
+	*out_schema = nullptr;
+	DUCKDB_CHECK_ARG(prepared);
+	return WithErrorHandler(err, [&]() {
+		auto &statement = *Convert(prepared)->prepared;
+		if (statement.SubmitsAnew()) {
+			throw MetadataDeferredException(
+			    "the statement expands into several, so its schema is known only once execution binds the one that "
+			    "produces the result; execute it instead");
+		}
+		auto schema = duckdb::make_uniq<CV2Schema>();
+		auto &names = statement.GetNames();
+		auto &types = statement.GetTypes();
+		for (duckdb::idx_t i = 0; i < types.size(); i++) {
+			schema->fields.push_back({names[i].GetIdentifierName(), types[i]});
+		}
+		*out_schema = Convert(schema.release());
+	});
+}
+
+DUCKDB_V2_ERROR duckdb_v2_prepared_statement_get_parameters(duckdb_v2_prepared_statement_handle prepared,
+                                                            duckdb_v2_schema_handle *out_parameters,
+                                                            duckdb_v2_error_info_handle *err) {
+	DUCKDB_CHECK_ARG(out_parameters);
+	*out_parameters = nullptr;
+	DUCKDB_CHECK_ARG(prepared);
+	return WithErrorHandler(err, [&]() {
+		auto &statement = *Convert(prepared)->prepared;
+		// In binding order, as statement_bind reports them; the field name carries the binding key.
+		duckdb::vector<std::pair<duckdb::idx_t, duckdb::Identifier>> order;
+		for (auto &entry : statement.GetNamedParameterMap()) {
+			order.emplace_back(entry.second, entry.first);
+		}
+		std::sort(order.begin(), order.end(),
+		          [](const auto &a, const auto &b) { return a.first < b.first; });
+		auto parameters = duckdb::make_uniq<CV2Schema>();
+		for (auto &entry : order) {
+			duckdb::LogicalType type(duckdb::LogicalTypeId::UNKNOWN);
+			statement.TryGetParameterType(entry.second, type);
+			parameters->fields.push_back({entry.second.GetIdentifierName(), std::move(type)});
+		}
+		*out_parameters = Convert(parameters.release());
+	});
+}

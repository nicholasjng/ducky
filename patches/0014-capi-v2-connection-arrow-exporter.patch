+#if DUCKDB_V2_API_ALLOW_UNSTABLE
+/*!
+ * Creates an exporter for one fixed list of columns, with the connection's Arrow settings; see
+ * `duckdb_v2_arrow_exporter_create()`, which takes a callback's context instead. Converts the chunks of a result outside
+ * any callback.
+ *
+ * Captures the connection's Arrow settings, so every array this exporter produces matches the schema
+ * `duckdb_v2_arrow_exporter_get_schema()` reports, even if a setting changes afterwards. Needs no transaction. The
+ * exporter keeps the connection's session alive, so it may outlive the connection handle.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param conn The connection whose Arrow settings are captured.
+ * @param types An array of `count` column types. May be NULL only when `count` is 0.
+ * @param names An array of `count` column names, parallel to `types`. Each name must be valid UTF-8. May be NULL only
+ * when `count` is 0.
+ * @param names_lengths Byte lengths of the entries in `names`; element i is the length of `names[i]`. May be NULL only
+ * when `names` is NULL.
+ * @param count The number of columns, being the length of both `types` and `names`.
+ * @param batch_size Maximum rows per produced array, or 0 for no maximum: each chunk becomes one array.
+ * @param out_exporter On success, receives the new exporter. Owned by the caller; destroy via
+ * `duckdb_v2_arrow_exporter_destroy()`.
+ * @param err Optional. On failure, receives an opaque info handle the caller must destroy via
+ * `duckdb_v2_error_info_destroy()`.
+ * @return DUCKDB_V2_ERROR
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_connection_create_arrow_exporter(
+    duckdb_v2_connection_handle conn, const duckdb_v2_logical_type_handle *types, const char **names,
+    const idx_t *names_lengths, idx_t count, idx_t batch_size, duckdb_v2_arrow_exporter_handle *out_exporter,
+    duckdb_v2_error_info_handle *err);
+#endif
+
+#ifdef __cplusplus
+}
+#endif

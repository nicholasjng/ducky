+namespace duckdb::capiv2 {
+namespace {
+
+unique_ptr<CV2ArrowExporter> CreateArrowExporter(ClientContext &ctx, const duckdb_v2_logical_type_handle *types,
+                                                 const char **names, const idx_t *names_lengths, idx_t count,
+                                                 idx_t batch_size) {
+	auto exporter = make_uniq<CV2ArrowExporter>();
+	exporter->batch_size = batch_size;
+	exporter->types.reserve(count);
+	exporter->names.reserve(count);
+	string_view_array name_views(names, names_lengths, count);
+	for (idx_t i = 0; i < count; i++) {
+		if (!types[i]) {
+			throw InvalidInputException("null logical type at index %llu", i);
+		}
+		auto type = Convert(types[i]);
+		exporter->types.push_back(*type);
+		exporter->names.emplace_back(name_views[i]);
+	}
+	// Pin the settings and the extension map now: the schema below and every array this exporter produces are built
+	// from them, which is what keeps the two consistent. Both come from the client and database config, so no
+	// transaction is needed.
+	exporter->properties = ctx.GetClientProperties();
+	exporter->extension_types = ArrowTypeExtensionData::GetExtensionTypes(ctx, exporter->types);
+	return exporter;
+}

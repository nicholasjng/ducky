+//===----------------------------------------------------------------------===//
+//
+//                         DuckDB
+//
+// duckdb_v2_result_take_collection.h
+//
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb_v2.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if DUCKDB_V2_API_ALLOW_UNSTABLE
+/*!
+ * Takes the rows of a retained result as a column data collection, once its query has run to its end.
+ *
+ * Stepping a retained result copies each chunk out of the collection that holds its rows, into a chunk allocated for
+ * the step. Taking the collection hands those rows over instead, without copying: scan them with
+ * `duckdb_v2_column_data_collection_scan()` into chunks the caller owns and reuses, zero-copy where possible, or in
+ * parallel. The result is finished afterwards, which frees the connection.
+ *
+ * While the query still runs, `*out_collection` receives NULL: step the result and call again. The step that ends
+ * execution reports `WAITING`, so calling this after each `WAITING` step takes the rows before any chunk is fetched.
+ * Fails with `ERROR_INPUT_INVALID`
+ * for a result that streams (see `duckdb_v2_result_retain()`), that has handed out a chunk or ended, or that is an Arrow
+ * result; with the result's error once it failed, and with `ERROR_RUNTIME_INTERRUPT` once it was cancelled.
+ *
+ * history:
+ * - unstable: v2.0.0
+ *
+ * @param result The result.
+ * @param out_collection Receives the collection, or NULL while the query runs. Owned by the caller; destroy via
+ * `duckdb_v2_column_data_collection_destroy()` before the instance.
+ * @param err Optional. On failure, receives an opaque info handle the caller must destroy via
+ * `duckdb_v2_error_info_destroy()`.
+ * @return DUCKDB_V2_ERROR
+ */
+DUCKDB_C_API DUCKDB_V2_ERROR duckdb_v2_result_take_collection(duckdb_v2_result_handle result,
+                                                              duckdb_v2_column_data_collection_handle *out_collection,
+                                                              duckdb_v2_error_info_handle *err);
+#endif
+
+#ifdef __cplusplus
+}
+#endif

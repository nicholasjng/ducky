+unique_ptr<ColumnDataCollection> ResultWrapperV2::TakeCollection() {
+	if (format && !format->Is<ChunkFormat>()) {
+		throw InvalidInputException("only the rows of a chunk result can be taken as a collection");
+	}
+	switch (state) {
+	case State::PENDING:
+		// Still running: the step that ends execution makes the rows available.
+		return nullptr;
+	case State::STREAMING:
+		break;
+	case State::FINISHED:
+		throw InvalidInputException("the result has ended; take its rows before stepping it to its end");
+	case State::CANCELLED:
+		throw InterruptException();
+	case State::ERRORED:
+		error.Throw();
+	}
+	if (stream) {
+		throw InvalidInputException("the result streams; retain it before stepping it to take its rows");
+	}
+	if (retained_fetched) {
+		throw InvalidInputException("a chunk was fetched from the result; take its rows before fetching any");
+	}
+	auto collection = handle->TakeCollection<ChunkFormat>();
+	// As at the end of the steps: the query has ended, and releasing its handle frees the connection.
+	handle.reset();
+	state = State::FINISHED;
+	return collection;
+}
+
 template <class FORMAT>
 unique_ptr<typename FORMAT::T> ResultWrapperV2::FetchBlocking() {
 	while (true) {
@@ -591,6 +623,15 @@ DUCKDB_V2_ERROR duckdb_v2_result_retain(duckdb_v2_result_handle result, duckdb_v
 	return WithErrorHandler(err, [&]() { Convert(result)->Retain(); });
 }
 
+DUCKDB_V2_ERROR duckdb_v2_result_take_collection(duckdb_v2_result_handle result,
+                                                 duckdb_v2_column_data_collection_handle *out_collection,
+                                                 duckdb_v2_error_info_handle *err) {
+	DUCKDB_CHECK_ARG(out_collection);
+	*out_collection = nullptr;
+	DUCKDB_CHECK_ARG(result);
+	return WithErrorHandler(err, [&]() { *out_collection = Convert(Convert(result)->TakeCollection().release()); });
+}
